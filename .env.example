# ============================================================================
# Configuración única del repositorio — vive en la RAIZ
# Se crea una copia local:  cp .env.example .env   (el .env NO se versiona)
# Backend y frontend leen este archivo (no buscan .env en subcarpetas).
# ============================================================================

# --- Backend (FastAPI) ---
# APP_MODE=demo   → /api/analyze devuelve un reporte sintético (validar frontend)
# APP_MODE=prod   → pipeline real (ArUco + preprocesamiento + filtro TFLite)
# Para hacer inferencia real desde la app usa APP_MODE=prod.
APP_MODE=demo
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Frontend (Expo / React Native) ---
# URL base de la API FastAPI (red local). Ajustar a la IP LAN de tu máquina.
# En un dispositivo físico no uses localhost: usa http://<IP-LAN>:8000.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000