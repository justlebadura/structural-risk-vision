# Copia este archivo a `.env` y ajusta los valores.

# Modo de ejecución del backend.
#   demo      -> usa un filtro heurístico (sin modelo) para debugging del pipeline y la UI.
#   funcional -> usa el modelo real backend/models/filter.tflite (inferencia real).
APP_MODE=demo

# [Opcional] Rutas y configuración del entrenamiento del filtro binario.
# TRAINING_DATASET_DIR=
# TRAINING_EPOCHS=10
# TRAINING_BATCH_SIZE=32
# TRAINING_LR=0.0001